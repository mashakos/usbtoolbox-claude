+            return
+        print()
+        print("The following controllers were found but could not be enumerated:")
+        for name, reason in self.skipped_controllers:
+            print(f"  - {name} ({reason})")
+
     def discover_ports(self):
         self.utils.head("Port Discovery")
         print()
@@ -230,6 +240,7 @@ class BaseUSBMap:
                 self.update_devices()
 
             self.print_controllers(self.controllers, colored=True)
+            self.print_skipped_controllers()
 
             self.dump_historical()
             print("\nB.  Back\n")
