@@ -51,8 +52,9 @@ class BaseUSBMap:
     @staticmethod
     def is_same_controller(controller_1, controller_2):
         common_keys: set[str] = set(i for i in controller_1["identifiers"] if controller_1["identifiers"][i]) & set(i for i in controller_2["identifiers"] if controller_2["identifiers"][i])
-        if not common_keys:
-            # No way to tell
+        if not common_keys - {"instance_id", "location_id"}:
+            # No way to tell. instance_id/location_id are ignored below (they change on hotplug), so matching on them alone
+            # would wrongly merge unrelated controllers into one and make one of them vanish.
             return False
         for key in common_keys:
             if key in ["instance_id", "location_id"]:
@@ -212,6 +214,14 @@ class BaseUSBMap:
             for i in device["devices"]:
                 self.print_devices(i, indentation + "  ")
 
+    def print_skipped_controllers(self):
